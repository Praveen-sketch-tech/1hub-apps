<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📄 Document Generator - User</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="app-container">
        <!-- Header -->
        <header class="app-header">
            <div class="brand">
                <span>📄</span> Document<span>Generator</span>
            </div>
            <div class="header-actions">
                <div class="lang-toggle">
                    <button class="lang-btn active" onclick="setLanguage('en')">🇬🇧 EN</button>
                    <button class="lang-btn" onclick="setLanguage('hi')">🇮🇳 HI</button>
                </div>
            </div>
        </header>

        <!-- Status Bar -->
        <div class="status-bar" id="statusBar"></div>

        <!-- Search -->
        <div style="margin-bottom:20px;">
            <input type="text" id="searchInput" placeholder="🔍 Search documents..." style="width:100%;padding:12px 16px;border:2px solid var(--border);border-radius:10px;font-size:1rem;">
        </div>

        <!-- Category Filters -->
        <div class="categories-grid" id="categoryFilters">
            <div class="category-card" onclick="filterByCategory('All')" style="cursor:pointer;">
                <div class="icon">📚</div>
                <div class="name">All</div>
                <div class="count" id="totalDocs">0 documents</div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('browse')">📄 Browse</button>
            <button class="tab-btn" onclick="switchTab('fill')">✏️ Fill Form</button>
        </div>

        <!-- Tab: Browse Documents -->
        <div class="tab-content active" id="tab-browse">
            <div class="documents-grid" id="documentsGrid">
                <div style="text-align:center;padding:50px;color:#999;grid-column:1/-1;">
                    Loading documents...
                    <div class="spinner" style="margin-top:10px;display:inline-block;"></div>
                </div>
            </div>
        </div>

        <!-- Tab: Fill Form -->
        <div class="tab-content" id="tab-fill">
            <div class="fill-area">
                <div class="fill-header">
                    <h3 id="fillingDocTitle">📝 Select a document to fill</h3>
                    <div>
                        <button class="btn btn-success" onclick="generatePDF()">📄 PDF / Print</button>
                    </div>
                </div>
                <div id="formFields"></div>
                <div id="previewArea" style="display:none;margin-top:20px;">
                    <h4>📄 Preview</h4>
                    <div id="previewContent" class="preview-box"></div>
                    <button class="btn btn-success" onclick="downloadPDF()" style="margin-top:15px;">⬇️ Download PDF</button>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer style="margin-top:30px;padding:15px 0;border-top:1px solid var(--border);text-align:center;color:var(--gray);font-size:0.85rem;">
            Document Generator • All documents stored securely
        </footer>
    </div>

    <script src="user.js"></script>
</body>
</html>
