{
  "version": 2,
  "builds": [
    {
      "src": "api/document-generator/telegram.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/ocr.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/api/document-generator/(.*)",
      "dest": "/api/document-generator/telegram.cjs"
    },
    {
      "src": "/api/ocr",
      "dest": "/api/ocr.cjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
